// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String            @id @default(cuid())
  email          String?           @unique
  name           String?
  password       String?
  image          String?
  emailVerified  DateTime?
  role           Role              @default(STUDENT)
  profile        Profile?
  teacherStatus  TeacherStatus?
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime          @default(now())
  
  // Quiz relations
  createdQuizzes Quiz[]            @relation("TeacherQuizzes")
  quizAttempts   QuizAttempt[]     @relation("StudentAttempts")
  
  // Chat relations
  teacherConversations Conversation[] @relation("TeacherConversations")
  studentConversations Conversation[] @relation("StudentConversations")
  sentMessages         Message[]      @relation("SentMessages")
  
  // Group chat relations
  createdGroups    Group[]         @relation("CreatedGroups")
  groupMemberships GroupMember[]   @relation("GroupMembers")
  sentGroupMessages GroupMessage[] @relation("SentGroupMessages")
  
  // Student notes relations - FIXED
  studentNotes     StudentNote[]   @relation("StudentNotes")    // Notes about this user
  createdNotes     StudentNote[]   @relation("TeacherNotes")    // Notes created by this user
  
  // Lesson Content relations
  createdContents  LessonContent[]
  
  // NEW - Video relations
  authoredVideos   LessonVideo[]   @relation("AuthoredVideos")  // Videos authored by this user
  
  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  birthdate DateTime
  school    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model TeacherStatus {
  userId      String   @id        // 1-to-1 with User
  selfieUrl   String               // Supabase Storage path
  verified    Boolean  @default(false)
  requestedAt DateTime @default(now())
  verifiedAt  DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_status")
}

enum Role {
  STUDENT
  TEACHER        // once verified
}

model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@map("verification_tokens")
}

model Lesson {
  id        String        @id @default(cuid())
  title     String
  subject   String
  type      String        // e.g. "ppt", "video", "scratch", "canva"
  fileUrl   String        // will point to Supabase Storage URL
  authorId  String        // FK → User.id
  published Boolean       @default(false) // Added for controlling lesson visibility
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt // Added for tracking updates

  // many-to-many with tags
  tags           LessonTag[]
  quizzes        Quiz[]        // back-relation for quizzes
  lessonContents LessonContent[]  // relation to lesson contents
  
  // NEW - Video relations
  videos         LessonVideo[]    // Videos for this lesson

  @@map("lessons")
}

model Tag {
  id      String        @id @default(cuid())
  name    String        @unique
  lessons LessonTag[]

  @@map("tags")
}

model LessonTag {
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId String
  tag      Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    String

  @@id([lessonId, tagId])
  @@map("lesson_tags")
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  lessonId    String
  authorId    String   // Teacher who created the quiz
  isActive    Boolean  @default(true)
  published   Boolean  @default(false) // Added for controlling quiz visibility
  timeLimit   Int?     // Time limit in minutes (optional)
  maxAttempts Int?     @default(1) // Maximum attempts allowed per student
  passingScore Int?    // Minimum score required to pass (optional)
  showResults Boolean  @default(true) // Whether to show results to students
  randomizeQuestions Boolean @default(false) // Randomize question order
  randomizeOptions Boolean @default(false) // Randomize option order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lesson      Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author      User       @relation("TeacherQuizzes", fields: [authorId], references: [id])
  questions   Question[]
  attempts    QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  questionText String  @db.Text // Changed to Text for longer questions
  questionImage String? // URL for question image
  order       Int      // Order of question in quiz
  points      Int      @default(1)
  explanation String?  @db.Text // Optional explanation for the correct answer
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     Option[]
  answers     Answer[]

  @@map("questions")
}

model Option {
  id          String   @id @default(cuid())
  questionId  String
  optionText  String   @db.Text // Changed to Text for longer options
  optionImage String?  // URL for option image
  isCorrect   Boolean  @default(false)
  order       Int      // Order of option
  createdAt   DateTime @default(now())

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers     Answer[]

  @@map("options")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  studentId   String
  score       Int      // Total points earned
  totalPoints Int      // Total possible points
  percentage  Float    // Calculated percentage score
  passed      Boolean? // Whether the attempt passed (if passingScore is set)
  startedAt   DateTime @default(now()) // When the attempt was started
  completedAt DateTime? // When the attempt was completed (null if not completed)
  timeSpent   Int?     // Time spent in seconds
  isCompleted Boolean  @default(false) // Whether the attempt is completed

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User     @relation("StudentAttempts", fields: [studentId], references: [id])
  answers     Answer[]

  // Allow multiple attempts per student per quiz (removed unique constraint)
  @@map("quiz_attempts")
}

model Answer {
  id            String @id @default(cuid())
  attemptId     String
  questionId    String
  selectedOptionId String?
  isCorrect     Boolean @default(false) // Whether the selected answer is correct
  pointsEarned  Int     @default(0) // Points earned for this answer

  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption Option?    @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId]) // One answer per question per attempt
  @@map("answers")
}

model Conversation {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher  User      @relation("TeacherConversations", fields: [teacherId], references: [id], onDelete: Cascade)
  student  User      @relation("StudentConversations", fields: [studentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([teacherId, studentId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String?  @db.Text
  fileUrl        String?
  fileName       String?
  fileType       String?
  fileSize       Int?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ================================
// GROUP CHAT MODELS - NEW
// ================================

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  imageUrl    String?  // Group avatar/image
  createdById String   // Teacher who created the group
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy      User           @relation("CreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)
  members        GroupMember[]
  messages       GroupMessage[]
  pinnedMessage  GroupMessage?  @relation("PinnedMessage", fields: [pinnedMessageId], references: [id])
  pinnedMessageId String?       @unique

  @@map("groups")
}

model GroupMember {
  id       String        @id @default(cuid())
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime      @default(now())
  lastReadAt DateTime?   // Add this field to track when user last read messages

  group    Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User          @relation("GroupMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId]) // One membership per user per group
  @@map("group_members")
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  content   String?  @db.Text
  fileUrl   String?
  fileName  String?
  fileType  String?
  fileSize  Int?
  isRead    Boolean  @default(false) // For message read status
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User     @relation("SentGroupMessages", fields: [senderId], references: [id], onDelete: Cascade)
  pinnedIn  Group?   @relation("PinnedMessage")
  
  @@map("group_messages")
}

enum GroupMemberRole {
  ADMIN    // Can manage group (add/remove members, change name, etc.)
  MEMBER   // Can only send messages
}

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  teacherId String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  student   User @relation("StudentNotes", fields: [studentId], references: [id])
  teacher   User @relation("TeacherNotes", fields: [teacherId], references: [id])
  
  @@map("student_notes")
}

// ================================
// LESSON CONTENT MODELS - NEW
// ================================

model LessonContent {
  id           String       @id @default(cuid())
  lessonId     String
  authorId     String
  type         ContentType
  title        String
  markdown     String?      @db.Text  // Stored Markdown/text
  fileUrl      String?      // Supabase storage path for files
  fileName     String?      // Original filename
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_contents")
}

enum ContentType {
  MARKDOWN
  PDF
  PPT
  DOC
  IMAGE
  OTHER
}

// ================================
// LESSON VIDEO MODELS - NEW
// ================================

model LessonVideo {
  id                String      @id @default(cuid())
  lessonId          String
  authorId          String
  title             String
  description       String?     @db.Text
  archiveIdentifier String      @unique  // Internet Archive item identifier
  archiveUrl        String      // Full IA video URL for embedding/viewing  
  directVideoUrl    String      // Direct MP4 URL for downloading
  fileSize          BigInt      // File size in bytes (using BigInt for large files)
  duration          Int?        // Video duration in seconds (optional)
  uploadStatus      UploadStatus @default(UPLOADING)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author  User   @relation("AuthoredVideos", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([authorId])
  @@map("lesson_videos")
}

enum UploadStatus {
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}
